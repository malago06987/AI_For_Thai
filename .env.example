# ==========================================
# AI for Thai API Configuration
# ==========================================
# กรุณานำ API Key ที่ได้จาก https://aiforthai.in.th (เมนู Profile / Developer) มาใส่ที่นี่
AIFORTHAI_API_KEY=JBciaUmiqUjKqxzInMlcDrTt3lTjXWq4

# Endpoint สำหรับตรวจจับหน้ากากอนามัย
MASK_DETECTION_URL=https://api.aiforthai.in.th/detectfacemask

# Endpoint สำหรับแปลงข้อความเป็นเสียง (VAJA TTS)
VAJA_TTS_URL=https://api.aiforthai.in.th/vaja
VAJA_SPEAKER=nana
VAJA_TEXT=ถอดหน้ากากออกด้วยดิวะ

# ==========================================
# Camera & Performance Configuration
# ==========================================
# หมายเลขกล้อง Webcam (0 คือกล้องเริ่มต้น)
CAMERA_INDEX=0

# ความกว้างและความสูงของเฟรมกล้อง
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# ช่วงเวลาการส่งภาพไปตรวจจับที่ API (วินาที) เพื่อป้องกันการเรียกถี่เกินไป
CHECK_INTERVAL_SECONDS=2.0

# ระยะเวลาหน่วงป้องกันการเล่นเสียงเตือนซ้ำ (วินาที)
ALERT_COOLDOWN_SECONDS=5.0

# เปิดใช้งานการแคชไฟล์เสียงที่ดาวน์โหลดมาหรือไม่ (true/false) เพื่อประหยัดโควตาและไม่ดีเลย์
ENABLE_AUDIO_CACHE=true
